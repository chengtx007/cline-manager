# Server
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data

# Admin token. If omitted, one is generated on first run and stored in data/config.json.
# ADMIN_TOKEN=atk-change-me

# Fixed first gateway API key for automated deployments. Only used when no key exists.
# GATEWAY_API_KEY=sk-cline-change-me

# Upstream gateway (defaults to Cline Pass).
# CLINE_BASE_URL=https://api.cline.bot/api/v1
# CLINE_RECOMMENDED_URL=https://api.cline.bot/api/v1/ai/cline/recommended-models
