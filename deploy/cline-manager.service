[Unit]
Description=Cline Manager (OpenAI-compatible Cline Pass gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cline
WorkingDirectory=/opt/cline-manager
Environment=DATA_DIR=/var/lib/cline-manager
Environment=HOST=127.0.0.1
Environment=PORT=8787
ExecStart=/usr/bin/node /opt/cline-manager/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
