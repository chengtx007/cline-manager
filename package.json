    "test:all": "node test/smoke.mjs && node test/ui.mjs"
  },
  "keywords": [
    "cline",
    "cline-pass",
    "openai",
    "gateway",
    "openrouter",
    "vercel-ai-gateway",
    "docker"
  ],
  "homepage": "https://github.com/chengtx007/cline-manager",
